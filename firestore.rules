rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} { allow read, write: if false; }

    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // Validation Blueprint
    function isValidUser(data) {
      return data.keys().hasAll(['username', 'adsWatched', 'updatedAt', 'telegramId', 'balance'])
        && data.username is string && data.username.size() <= 100
        && data.adsWatched is int && data.adsWatched >= 0
        && data.balance is number && data.balance >= 0
        && (data.get('consumedInvites', 0) is int)
        && (data.get('has_withdrawn', false) is bool)
        && (data.get('adsSinceLastWithdrawal', 0) is int)
        && data.updatedAt == request.time
        && data.telegramId is int
        // Strict key check for creation
        && (request.method != 'create' || data.keys().size() >= 5);
    }

    function isValidWithdrawal(data) {
      return data.keys().hasAll(['amount', 'method', 'status', 'createdAt', 'userId'])
        && data.amount is number && data.amount >= 30
        && data.method is string && data.method.size() <= 100
        && (data.status == 'Pending' || data.status == 'Success' || data.status == 'Rejected')
        && data.userId == request.auth.uid;
    }

    match /users/{userId} {
      // Allow getting profile. List is enabled for inviter lookups.
      allow get: if isOwner(userId);
      allow list: if isSignedIn() && (resource.data.telegramId == request.auth.uid || resource.data.telegramId is int);
      
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming())
        && (incoming().invitedBy == null || (
             // Atomicity: If invited, the inviter's referral record must be created in the same batch
             existsAfter(/databases/$(database)/documents/users/$(incoming().invitedBy)/referrals/$(userId))
           ));
      
      allow update: if (isOwner(userId) && isValidId(userId) && isValidUser(incoming()))
        || (
          // Action: Referral Reward (50 points)
          isSignedIn() && !isOwner(userId)
          && incoming().balance == existing().balance + 50
          && (incoming().referralsCount == (existing().get('referralsCount', 0) + 1))
          && (incoming().total_invites == (existing().get('total_invites', 0) + 1))
          && (incoming().referralEarnings == (existing().get('referralEarnings', 0.0) + 50))
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'referralsCount', 'total_invites', 'referralEarnings', 'updatedAt'])
        )
        || (
          // Action: Self-Update (Tasks/Ads/Check-in/Withdrawal deduction)
          isOwner(userId)
          && incoming().diff(existing()).affectedKeys().hasAny(['consumedInvites', 'updatedAt', 'has_withdrawn', 'adsSinceLastWithdrawal', 'balance', 'dailyStreak', 'lastDailyClaim', 'tasksCompleted', 'adsWatched'])
          // Terminal status lock: If user has withdrawn, they can't reset balance to 0 without logic
          && (existing().get('balance', 0) >= 0)
        );

      match /referrals/{refId} {
        allow read: if isOwner(userId);
        // Allow creation if the referral record is part of a join batch
        allow create: if isSignedIn() && isValidId(refId); 
      }

      match /withdrawals/{withdrawalId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(withdrawalId) && isValidWithdrawal(incoming()) && incoming().createdAt == request.time;
        allow update: if isOwner(userId) && isValidWithdrawal(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      }
    }
  }
}
